#include <iostream>
using namespace std;
void read(int arr[ ], int n)
{
    cout << "Enter " << n << " elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }
}

void display(int arr[ ], int n)
{
    for (int i = 0; i < n; i++)
    {
        cout << arr[ i ] << " ";
    }
    cout << endl;
}

void swap(int &a, int &b)
{
    int temp;
    temp = a;
    a = b;
    b = temp;
}
void sort(int arr[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        for (int j = i + 1; j < n; j++)
        {
            if (arr[i] > arr[j])
            {
                swap(arr[i], arr[j]);
            }
        }
    }
}

int main()
{
    int n;

    cout << "Enter the size of the array: ";
    cin >> n;

    int arr[n];

    read(arr, n);

    cout << "\nArray before sorting: ";
    display(arr, n);

    sort(arr, n);

    cout << "Array after sorting: ";
    display(arr, n);

    return 0;
}
