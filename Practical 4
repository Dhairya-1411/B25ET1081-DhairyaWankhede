#include <iostream>
using namespace std;

class Calculator
{
public:
    void calculate(int a, int b)
    {
        cout << "Addition = " << a + b << endl;
    }
    void calculate(double a, double b)
    {
        cout << "Subtraction = " << a - b << endl;
    }
};

int main()
{
    Calculator c;

    c.calculate(10, 5);        
    c.calculate(10.5, 5.5);   

    return 0;
}
