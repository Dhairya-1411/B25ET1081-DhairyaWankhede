#include <iostream>
#include <string>
using namespace std;

class String
{
    string str;

public:
    // Default constructor
    String()
    {
        str = "";
    }

    // Parameterized constructor
    String(string s)
    {
        str = s;
    }

    // Function to accept string
    void accept()
    {
        cout << "Enter a string: ";
        getline(cin, str);
    }

    // Function to display string
    void display()
    {
        cout << "String: " << str << endl;
    }

    // Destructor
    ~String()
    {
        cout << "Destructor called" << endl;
    }
};

int main()
{
    String s1;          // Default constructor
    s1.accept();
    s1.display();

    String s2("Hello"); // Parameterized constructor
    s2.display();

    return 0;
}
