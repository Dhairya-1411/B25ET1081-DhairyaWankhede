#include <iostream>
using namespace std;

class Complex
{
    float real, imag;

public:
    void input()
    {
        cout << "Enter real and imaginary parts: ";
        cin >> real >> imag;
    }

    Complex add(Complex c)
    {
        Complex temp;
        temp.real = real + c.real;
        temp.imag = imag + c.imag;
        return temp;
    }

    Complex subtract(Complex c)
    {
        Complex temp;
        temp.real = real - c.real;
        temp.imag = imag - c.imag;
        return temp;
    }

    void display()
    {
        cout << real << " + " << imag << "i";
    }
};

int main()
{
    Complex c1, c2, c3, sum, result;

    c1.input();
    c2.input();
    c3.input();

    sum = c1.add(c2);
    result = sum.subtract(c3);

    cout << "Result = ";
    result.display();

    return 0;
}
